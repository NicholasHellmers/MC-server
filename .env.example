# =====================================================================
# MINECRAFT SERVER & CLOUD CONFIGURATION TEMPLATE
# Copy this file to .env and replace placeholder values with your secrets.
# =====================================================================

# Server Memory & Properties
SERVER_MEMORY=10G
SERVER_MOTD=§6Cobblemon Adventure §7| §aLatAm Server
MAX_PLAYERS=16
VIEW_DISTANCE=10
SIMULATION_DISTANCE=8
DIFFICULTY=easy
ONLINE_MODE=true
PVP=true
ALLOW_FLIGHT=true

# RCON Password for administration & atomic backups
RCON_PASSWORD=change_this_secure_rcon_password_123

# Cloudflare R2 S3-Compatible Storage Credentials (for offsite backups)
R2_BUCKET_NAME=mc-cobblemon-backups
R2_ACCOUNT_ID=your_cloudflare_account_id_hex
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# AWS Compute Credentials (used by Python provisioning tools)
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# SSH Remote Server Details (used by CI/CD deployment scripts)
SERVER_HOST=18.230.xx.xx
SERVER_USER=ubuntu
SERVER_SSH_KEY_PATH=~/.ssh/id_rsa

# Discord Notification Webhook
DISCORD_WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
